# Copy thành .env nếu muốn đổi giá trị mặc định (docker-compose đã có sẵn default)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud
GATEWAY_PORT=8080
JWT_SECRET=dev-only-change-me
SIMULATOR_API_KEY=dev-sim-key
PII_SALT=dev-salt
APP_BASE_URL=http://localhost:8080
# SMTP is required for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
MODEL_ARTIFACT_PATH=data/models/fraud_xgboost.joblib
MODEL_REQUIRED=true
# Giả lập LLM: độ trễ (giây) và tỉ lệ lỗi để test circuit breaker / FAILED_TIMEOUT
LLM_STUB_LATENCY_S=1.0
LLM_STUB_FAIL_RATE=0.0
# Tiêm lỗi dịch vụ ML (scoring worker): tỉ lệ lỗi 0..1 và độ trễ thêm (ms).
# Simulator/admin đổi được lúc chạy qua PUT /api/v1/admin/fault-injection;
# đặt FAULT_INJECTION_ENABLED=false để khóa hẳn tính năng này.
FAULT_INJECTION_ENABLED=true
ML_FAULT_RATE=0.0
ML_FAULT_LATENCY_MS=0
# Chu kỳ (giây) Analyst API tính lại drift và cập nhật metric Prometheus.
DRIFT_MONITOR_INTERVAL_S=60

# Keep both provider groups below. This switch selects the application worker only:
# api = Claude/Gemini/hosted API; ollama = local model. Recreate the worker after changing it.
# Without .env or LLM_PROVIDER, the demo still uses stub.
LLM_PROVIDER=api
LLM_RETRIEVER=playbook
LLM_CONCURRENCY=1
LLM_JOB_TIMEOUT_S=120
LLM_VISIBILITY_TIMEOUT_S=300
LLM_MAX_ATTEMPTS=3
# Total prompt + completion tokens per attempt; independent of the output cap.
BRIEF_TOKEN_BUDGET=5000
REGEN_LIMIT_PER_HOUR=3
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_S=30

# Hosted API example: Gemini via the OpenAI-compatible endpoint.
# Use a model with available quota in your Google AI Studio project.
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_API_RESPONSE_FORMAT=json_schema
LLM_API_TOKEN_PARAMETER=max_tokens
LLM_API_STORE=omit
LLM_API_MAX_COMPLETION_TOKENS=1024
# Optional; leave empty for provider/model default.
LLM_API_REASONING_EFFORT=
# Optional Anthropic Haiku 5.5 extension; blank preserves provider defaults.
LLM_API_THINKING=
LLM_API_BRIEF_MODE=explained

# Alternative: Haiku v29 via Anthropic's OpenAI-compatible endpoint.
# Replace the corresponding active values above with this profile.
# Keep LLM_PROVIDER=api. Put your own Anthropic API key in LLM_API_KEY.
# LLM_API_BASE_URL=https://api.anthropic.com/v1
# LLM_API_MODEL=claude-haiku-5-5
# LLM_API_KEY=
# LLM_API_RESPONSE_FORMAT=json_schema
# LLM_API_TOKEN_PARAMETER=max_tokens
# LLM_API_STORE=omit
# LLM_API_MAX_COMPLETION_TOKENS=3072
# LLM_API_REASONING_EFFORT=
# LLM_API_THINKING=disabled
# LLM_API_BRIEF_MODE=grounded_selection
# BRIEF_TOKEN_BUDGET=8000
# See docs/llm/localhost-haiku.md for the complete deployment profile.

# For local Ollama, set LLM_PROVIDER=ollama and use docker-compose.ollama.yml.
# Set LLM_RETRIEVER=ollama for semantic retrieval (requires embeddinggemma:300m).
# Use http://127.0.0.1:11434 when running Python directly on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=embeddinggemma:300m
OLLAMA_MAX_COMPLETION_TOKENS=1024
OLLAMA_KEEP_ALIVE=10m
OLLAMA_EMBED_KEEP_ALIVE=0
OLLAMA_EMBED_CACHE_TTL_S=300
# Benchmark both regardless of LLM_PROVIDER: see docs/benchmarks/README.md.
