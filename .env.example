# Copy thành .env nếu muốn đổi giá trị mặc định (docker-compose đã có sẵn default)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud
GATEWAY_PORT=8080
JWT_SECRET=dev-only-change-me
SIMULATOR_API_KEY=dev-sim-key
PII_SALT=dev-salt
APP_BASE_URL=http://localhost:8080
# SMTP is required for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
MODEL_ARTIFACT_PATH=data/models/fraud_xgboost.joblib
MODEL_REQUIRED=true
# Giả lập LLM: độ trễ (giây) và tỉ lệ lỗi để test circuit breaker / FAILED_TIMEOUT
LLM_STUB_LATENCY_S=1.0
LLM_STUB_FAIL_RATE=0.0
