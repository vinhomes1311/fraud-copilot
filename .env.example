# Copy thành .env nếu muốn đổi giá trị mặc định (docker-compose đã có sẵn default)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud
GATEWAY_PORT=8080
JWT_SECRET=dev-only-change-me
SIMULATOR_API_KEY=dev-sim-key
PII_SALT=dev-salt
APP_BASE_URL=http://localhost:8080
# SMTP is required for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
MODEL_ARTIFACT_PATH=data/models/fraud_xgboost.joblib
MODEL_REQUIRED=true
# Giả lập LLM: độ trễ (giây) và tỉ lệ lỗi để test circuit breaker / FAILED_TIMEOUT
LLM_STUB_LATENCY_S=1.0
LLM_STUB_FAIL_RATE=0.0

# Online LLM: copied .env enables the API in Docker and host Python workers.
# Without .env or LLM_PROVIDER, the demo still uses stub.
LLM_PROVIDER=api
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_MODEL=gpt-5.4-mini
LLM_API_KEY=
LLM_API_RESPONSE_FORMAT=json_schema
LLM_API_TOKEN_PARAMETER=max_completion_tokens
LLM_API_MAX_COMPLETION_TOKENS=1024
# Optional; leave empty for provider/model default. For gpt-5.4-mini: none or low.
LLM_API_REASONING_EFFORT=
LLM_RETRIEVER=playbook
LLM_CONCURRENCY=1
LLM_JOB_TIMEOUT_S=120
LLM_VISIBILITY_TIMEOUT_S=300

# For local Ollama, set LLM_PROVIDER=ollama and use docker-compose.ollama.yml.
# Set LLM_RETRIEVER=ollama for semantic retrieval (requires embeddinggemma:300m).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=embeddinggemma:300m
# OLLAMA_MAX_COMPLETION_TOKENS=128
# OLLAMA_KEEP_ALIVE=10m
# OLLAMA_EMBED_KEEP_ALIVE=0
# OLLAMA_EMBED_CACHE_TTL_S=300
