# Copy thành .env nếu muốn đổi giá trị mặc định (docker-compose đã có sẵn default)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud
GATEWAY_PORT=8080
JWT_SECRET=dev-only-change-me
SIMULATOR_API_KEY=dev-sim-key
PII_SALT=dev-salt
# Giả lập LLM: độ trễ (giây) và tỉ lệ lỗi để test circuit breaker / FAILED_TIMEOUT
LLM_STUB_LATENCY_S=1.0
LLM_STUB_FAIL_RATE=0.0

# External LLM API: use docker-compose.yml + docker-compose.api.yml.
# Host Python workers require these variables in the shell environment.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_MODEL=
LLM_API_KEY=
LLM_API_RESPONSE_FORMAT=json_schema
LLM_API_TOKEN_PARAMETER=max_completion_tokens
LLM_API_MAX_COMPLETION_TOKENS=1024
LLM_RETRIEVER=playbook
LLM_CONCURRENCY=1
LLM_JOB_TIMEOUT_S=120
LLM_VISIBILITY_TIMEOUT_S=300
